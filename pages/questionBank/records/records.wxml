<view class="question-page">
  <view class="records-shell">
    <view class="records-tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="records-tab {{activeTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchTab">{{item.name}}</view>
    </view>

    <view wx:for="{{records}}" wx:key="id" class="record-card question-card">
      <view class="record-head">
        <view class="record-title">{{item.title}}</view>
        <view class="record-time">{{item.timeText}}</view>
      </view>
      <view class="record-result">{{item.result}}</view>
      <view class="record-detail">{{item.detail}}</view>
    </view>

    <view wx:if="{{!records.length}}" class="question-empty question-card">
      <view class="question-empty-mark">录</view>
      <view class="question-empty-title">暂无{{activeTab === 'practice' ? '练习' : '考试'}}记录</view>
      <view class="question-empty-desc">完成后会自动保存在本机</view>
    </view>
  </view>
</view>
