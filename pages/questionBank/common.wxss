.question-page {
  min-height: 100vh;
  overflow-x: hidden;
  background: linear-gradient(180deg, #edf6ff 0%, #f6f9fd 42%, #f4f6f8 100%);
  color: #1f2f46;
}

.question-shell {
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
}

.question-nav-title {
  margin-bottom: 22rpx;
  color: #1f2933;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.question-hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 176rpx;
  padding: 34rpx 30rpx;
  overflow: hidden;
  border: 1rpx solid rgba(59, 130, 246, 0.2);
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f0f8ff 0%, #cfe9ff 54%, #8fc7ff 100%);
  box-shadow: 0 18rpx 46rpx rgba(37, 99, 235, 0.12);
}

.question-hero::before {
  position: absolute;
  top: -90rpx;
  right: 48rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.52);
  content: '';
}

.question-hero-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.question-hero-title {
  color: #1558a8;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.question-hero-subtitle {
  margin-top: 16rpx;
  color: #2f78c9;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.question-hero-image {
  position: relative;
  z-index: 1;
  flex: 0 0 150rpx;
  width: 150rpx;
  height: 140rpx;
  margin-left: 24rpx;
}

.question-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(31, 72, 116, 0.06);
}

.question-section {
  margin-top: 26rpx;
}

.question-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.question-section-title {
  color: #344960;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.question-section-action {
  color: #2f78c9;
  font-size: 24rpx;
}

.question-meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin: -6rpx;
}

.question-tag {
  margin: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #2f78c9;
  font-size: 22rpx;
  line-height: 32rpx;
}

.question-tag.muted {
  background: #f4f6f8;
  color: #667085;
}

.question-empty {
  padding: 72rpx 32rpx;
  text-align: center;
}

.question-empty-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  background: #eef6ff;
  color: #1677ff;
  font-size: 30rpx;
  font-weight: 800;
}

.question-empty-title {
  margin-top: 20rpx;
  color: #344960;
  font-size: 28rpx;
  font-weight: 700;
}

.question-empty-desc {
  margin-top: 10rpx;
  color: #7b8794;
  font-size: 24rpx;
  line-height: 36rpx;
}

.question-list-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.question-list-card:active,
.question-entry:active,
.question-row:active {
  opacity: 0.88;
}

.question-stem {
  color: #273244;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 46rpx;
  word-break: break-all;
}

.question-option-list {
  margin-top: 22rpx;
}

.question-option {
  display: flex;
  align-items: flex-start;
  min-height: 84rpx;
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #eef1f5;
  border-radius: 18rpx;
  background: #ffffff;
}

.question-option:first-child {
  margin-top: 0;
}

.question-option:active {
  opacity: 0.84;
}

.question-option.selected {
  border-color: #79b7ff;
  background: #eef6ff;
}

.question-option.correct {
  border-color: #7fdc83;
  background: #effdf5;
}

.question-option.wrong {
  border-color: #ef4444;
  background: #ffffff;
}

.question-option-key {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #eef5ff;
  color: #1769e0;
  font-size: 24rpx;
  font-weight: 700;
}

.question-option.selected .question-option-key {
  background: #1677ff;
  color: #ffffff;
}

.question-option.correct .question-option-key {
  background: #31a852;
  color: #ffffff;
}

.question-option.wrong .question-option-key {
  background: #ef4444;
  color: #ffffff;
}

.question-option-text {
  flex: 1;
  min-width: 0;
  color: #344960;
  font-size: 27rpx;
  line-height: 44rpx;
  word-break: break-all;
}

.question-answer-card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid rgba(80, 156, 255, 0.32);
  border-radius: 24rpx;
  background: linear-gradient(180deg, #edf7ff 0%, #fbfdff 100%);
}

.question-answer-title {
  color: #1558a8;
  font-size: 27rpx;
  font-weight: 700;
}

.question-answer-text {
  margin-top: 12rpx;
  color: #58728f;
  font-size: 25rpx;
  line-height: 42rpx;
  word-break: break-all;
}

.question-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.question-text-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 64rpx;
  padding: 0 22rpx;
  border: 1rpx solid #edf4fb;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2f78c9;
  font-size: 25rpx;
  line-height: 1.2;
  text-align: center;
}

.question-text-button.disabled {
  color: #b7c0cc;
  opacity: 0.65;
}

.question-action-group {
  margin-top: 30rpx;
}

.question-page .primary-button,
.question-page .secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1.2;
  text-align: center;
}

.question-action-group .secondary-button {
  margin-top: 18rpx;
}
