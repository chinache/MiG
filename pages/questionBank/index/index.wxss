@import "../common.wxss";

.search-entry {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  margin-top: 26rpx;
  padding: 0 26rpx;
}

.search-entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin-right: 18rpx;
  border-radius: 18rpx;
  background: #eef6ff;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 800;
}

.search-entry-text {
  flex: 1;
  color: #7b8794;
  font-size: 27rpx;
}

.search-entry-arrow {
  color: #8da5bd;
  font-size: 42rpx;
  line-height: 1;
}

.core-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx -10rpx -10rpx;
}

.core-entry {
  width: calc(50% - 20rpx);
  min-height: 220rpx;
  margin: 10rpx;
  padding: 30rpx 22rpx 28rpx;
  text-align: center;
  border: 1rpx solid rgba(226, 235, 247, 0.9);
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(47, 92, 139, 0.08);
}

.core-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin: 0 auto;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #79b7ff 0%, #1f74f2 100%);
  box-shadow: 0 12rpx 24rpx rgba(36, 121, 242, 0.18);
}

.core-icon-symbol {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
}

.core-name {
  margin-top: 22rpx;
  color: #1d2939;
  font-size: 31rpx;
  font-weight: 700;
}

.core-desc {
  margin-top: 8rpx;
  color: #7a8797;
  font-size: 22rpx;
  line-height: 34rpx;
}
