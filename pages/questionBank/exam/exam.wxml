<view class="question-page">
  <view class="exam-header">
    <view class="exam-stat">
      <view class="exam-stat-value">{{currentIndex + 1}}/{{questions.length}}</view>
      <view class="exam-stat-label">当前题号</view>
    </view>
    <view class="exam-stat">
      <view class="exam-stat-value">{{answeredCount}}</view>
      <view class="exam-stat-label">已答题数</view>
    </view>
    <view class="exam-stat">
      <view class="exam-stat-value timer">{{remainingText}}</view>
      <view class="exam-stat-label">剩余时间</view>
    </view>
  </view>

  <view class="exam-content" wx:if="{{currentQuestion}}">
    <view class="question-card exam-question-card">
      <view class="question-meta-row">
        <view class="question-tag">{{currentQuestion.typeLabel}}</view>
        <view class="question-tag muted">{{currentQuestion.bank}}</view>
        <view class="exam-number">{{currentQuestion.number}}</view>
      </view>
      <view class="question-stem exam-stem">{{currentIndex + 1}}. {{currentQuestion.stem}}</view>
      <view class="question-option-list">
        <view wx:for="{{currentQuestion.displayOptions}}" wx:key="key" class="{{item.className}}" data-key="{{item.key}}" bindtap="selectOption">
          <view class="question-option-key">{{item.key}}</view>
          <view class="question-option-text">{{item.text}}</view>
        </view>
      </view>
    </view>

    <view class="question-toolbar">
      <view class="question-text-button {{currentIndex === 0 ? 'disabled' : ''}}" bindtap="previousQuestion">上一题</view>
      <view class="question-text-button" bindtap="toggleAnswerSheet">答题卡</view>
      <view class="question-text-button" bindtap="nextQuestion">{{currentIndex === questions.length - 1 ? '答题卡' : '下一题'}}</view>
    </view>

    <view class="question-action-group">
      <button class="primary-button" bindtap="confirmSubmit">交卷</button>
    </view>
  </view>

  <view wx:if="{{answerSheetVisible}}" class="answer-sheet-mask" catchtap="toggleAnswerSheet">
    <view class="answer-sheet-panel" catchtap="noop">
      <view class="answer-sheet-head">
        <view class="answer-sheet-title">答题卡</view>
        <view class="answer-sheet-summary">已答 {{answeredCount}} / {{questions.length}}</view>
      </view>
      <view class="answer-sheet-grid">
        <view wx:for="{{answerSheet}}" wx:key="index" class="{{item.className}}" data-index="{{item.index}}" bindtap="goQuestion">{{item.number}}</view>
      </view>
      <button class="secondary-button answer-sheet-close" bindtap="toggleAnswerSheet">继续答题</button>
    </view>
  </view>
</view>
